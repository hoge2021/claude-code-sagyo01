{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Module Analyst Output",
  "type": "object",
  "required": [
    "module", "module_path", "analyzed_at", "files_read",
    "Q1_what_it_configures", "Q2_modification_patterns",
    "Q4_cross_module_deps", "Q5_tribal_knowledge_from_comments", "stats"
  ],
  "properties": {
    "module": {"type": "string"},
    "module_path": {"type": "string"},
    "analyzed_at": {"type": "string", "format": "date-time"},
    "files_read": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "Q1_what_it_configures": {"type": "string", "minLength": 10},
    "Q2_modification_patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["pattern", "example_files"],
        "properties": {
          "pattern": {"type": "string"},
          "example_files": {"type": "array", "items": {"type": "string"}},
          "example_change": {"type": "string"}
        }
      }
    },
    "Q3_non_obvious_patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "trap", "evidence_file", "why_non_obvious", "confidence", "confidence_score"],
        "properties": {
          "name": {"type": "string"},
          "trap": {"type": "string"},
          "evidence_file": {"type": "string"},
          "why_non_obvious": {"type": "string"},
          "confidence": {"type": "string", "enum": ["EXTRACTED", "INFERRED", "AMBIGUOUS"]},
          "confidence_score": {"type": "number", "minimum": 0.0, "maximum": 1.0},
          "related_modules": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "Q3_hyperedges": {
      "type": "array",
      "description": "Tribal v2: 3+ module を跨ぐ共通 trap を pairwise edge では表現できない場合に記録",
      "items": {
        "type": "object",
        "required": ["id", "label", "modules", "trap"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "label": {"type": "string"},
          "modules": {"type": "array", "minItems": 3, "items": {"type": "string"}},
          "trap": {"type": "string"},
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["file"],
              "properties": {
                "file": {"type": "string"},
                "line": {"type": "integer", "minimum": 1}
              }
            }
          },
          "confidence": {"type": "string", "enum": ["EXTRACTED", "INFERRED", "AMBIGUOUS"]},
          "confidence_score": {"type": "number", "minimum": 0.0, "maximum": 1.0}
        }
      }
    },
    "Q3_search_log": {
      "type": "object",
      "description": "Q3 が見つからなかった場合の代替",
      "required": ["patterns_searched", "files_inspected", "conclusion"],
      "properties": {
        "patterns_searched": {"type": "array", "items": {"type": "string"}},
        "files_inspected": {"type": "array", "items": {"type": "string"}},
        "conclusion": {"type": "string"}
      }
    },
    "Q4_cross_module_deps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["target", "kind"],
        "properties": {
          "target": {"type": "string"},
          "kind": {
            "type": "string",
            "enum": ["import", "config", "runtime", "serialization", "build", "schema"]
          },
          "fragility": {"type": "string"},
          "evidence": {"type": "string"}
        }
      }
    },
    "Q5_tribal_knowledge_from_comments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding", "source"],
        "properties": {
          "finding": {"type": "string"},
          "source": {"type": "string"},
          "category": {
            "type": "string",
            "enum": ["comment", "commit_message", "pr_description"]
          }
        }
      }
    },
    "stats": {
      "type": "object",
      "required": ["files_count", "files_read_count"],
      "properties": {
        "files_count": {"type": "integer", "minimum": 0},
        "files_read_count": {"type": "integer", "minimum": 0},
        "lines_of_code": {"type": "integer", "minimum": 0}
      }
    }
  },
  "oneOf": [
    {"required": ["Q3_non_obvious_patterns"]},
    {"required": ["Q3_search_log"]}
  ]
}
