{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Routing Table",
  "type": "object",
  "required": ["generated_at", "intents", "fallback"],
  "properties": {
    "generated_at": {"type": "string", "format": "date-time"},
    "intents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["name", "keywords", "primary_contexts", "max_contexts"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "description": {"type": "string"},
          "keywords": {
            "type": "array",
            "items": {"type": "string"},
            "minItems": 1
          },
          "anti_keywords": {
            "type": "array",
            "items": {"type": "string"}
          },
          "primary_contexts": {
            "type": "array",
            "items": {"type": "string"},
            "minItems": 1,
            "maxItems": 3
          },
          "secondary_contexts": {
            "type": "array",
            "items": {"type": "string"},
            "maxItems": 4
          },
          "max_contexts": {
            "type": "integer",
            "minimum": 3,
            "maximum": 5
          },
          "community_hint": {
            "type": ["integer", "null"],
            "description": "Tribal v2: この intent が主にヒットする community ID (router の 2 段階選定用)"
          },
          "god_node_recommended": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Tribal v2: god-node-detector 推薦を routing-upgrader が採用したもの"
          },
          "rejected_recommendations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "context": {"type": "string"},
                "reason": {"type": "string"}
              }
            },
            "description": "Tribal v2: god-node 推薦のうち却下したもの (理由付き)"
          }
        }
      }
    },
    "wiki_index": {
      "type": "string",
      "description": "Tribal v2: intent 不明時の fallback ナビゲーション entry (.claude/context/_index.md)"
    },
    "fallback": {
      "type": "object",
      "required": ["primary_contexts", "max_contexts"],
      "properties": {
        "description": {"type": "string"},
        "primary_contexts": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 1
        },
        "max_contexts": {"type": "integer", "minimum": 1, "maximum": 5}
      }
    }
  }
}
