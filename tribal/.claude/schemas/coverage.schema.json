{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Coverage Audit Output",
  "type": "object",
  "required": [
    "generated_at", "total_modules", "covered_modules", "coverage_ratio"
  ],
  "properties": {
    "generated_at": {"type": "string", "format": "date-time"},
    "last_success_sha": {
      "type": ["string", "null"],
      "description": "git SHA at last successful init/refresh"
    },
    "total_modules": {"type": "integer", "minimum": 0},
    "covered_modules": {"type": "integer", "minimum": 0},
    "coverage_ratio": {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "missing_modules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["module", "expected_context", "reason"],
        "properties": {
          "module": {"type": "string"},
          "expected_context": {"type": "string"},
          "reason": {
            "type": "string",
            "enum": ["missing", "stale", "invalid"]
          }
        }
      }
    },
    "orphan_contexts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "reason"],
        "properties": {
          "path": {"type": "string"},
          "reason": {"type": "string"}
        }
      }
    },
    "stale_modules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["module", "reason"],
        "properties": {
          "module": {"type": "string"},
          "reason": {"type": "string"}
        }
      }
    },
    "invalid_contexts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "validation_errors"],
        "properties": {
          "path": {"type": "string"},
          "validation_errors": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
