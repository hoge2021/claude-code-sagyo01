{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Context Critic Output",
  "type": "object",
  "required": ["file", "evaluated_at", "round", "scores", "overall", "verdict"],
  "properties": {
    "file": {"type": "string"},
    "evaluated_at": {"type": "string", "format": "date-time"},
    "round": {"type": "integer", "minimum": 1, "maximum": 3},
    "scores": {
      "type": "object",
      "required": [
        "conciseness", "path_accuracy", "non_obvious_value",
        "modification_readiness", "cross_ref_integrity"
      ],
      "properties": {
        "conciseness": {"type": "number", "minimum": 0.0, "maximum": 5.0},
        "path_accuracy": {"type": "number", "minimum": 0.0, "maximum": 5.0},
        "non_obvious_value": {"type": "number", "minimum": 0.0, "maximum": 5.0},
        "modification_readiness": {"type": "number", "minimum": 0.0, "maximum": 5.0},
        "cross_ref_integrity": {"type": "number", "minimum": 0.0, "maximum": 5.0}
      }
    },
    "overall": {"type": "number", "minimum": 0.0, "maximum": 5.0},
    "verdict": {"type": "string", "enum": ["PASS", "FIX"]},
    "fixes_required": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["axis", "issue", "suggested_fix"],
        "properties": {
          "axis": {
            "type": "string",
            "enum": [
              "conciseness", "path_accuracy", "non_obvious_value",
              "modification_readiness", "cross_ref_integrity"
            ]
          },
          "line_range": {
            "type": "array",
            "items": {"type": "integer"},
            "minItems": 2, "maxItems": 2
          },
          "issue": {"type": "string"},
          "suggested_fix": {"type": "string"}
        }
      }
    },
    "broken_paths": {"type": "array", "items": {"type": "string"}}
  }
}
