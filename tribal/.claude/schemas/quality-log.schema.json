{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Quality Log Entry (one per JSONL line)",
  "description": "Each line in _quality-log.jsonl conforms to this schema. Append-only.",
  "type": "object",
  "required": [
    "timestamp", "module", "file", "round", "scores", "overall", "verdict"
  ],
  "properties": {
    "timestamp": {"type": "string", "format": "date-time"},
    "module": {"type": "string"},
    "file": {"type": "string", "description": ".claude/context/<flat>.md"},
    "round": {
      "oneOf": [
        {"type": "integer", "minimum": 1, "maximum": 3},
        {"type": "string", "enum": ["validation", "ci-check"]}
      ]
    },
    "phase": {
      "type": "string",
      "enum": ["init", "refresh", "validate", "ci"],
      "description": "Which command/context produced this entry"
    },
    "scores": {
      "type": "object",
      "required": [
        "conciseness", "path_accuracy", "non_obvious_value",
        "modification_readiness", "cross_ref_integrity"
      ],
      "properties": {
        "conciseness": {"type": "number", "minimum": 0, "maximum": 5},
        "path_accuracy": {"type": "number", "minimum": 0, "maximum": 5},
        "non_obvious_value": {"type": "number", "minimum": 0, "maximum": 5},
        "modification_readiness": {"type": "number", "minimum": 0, "maximum": 5},
        "cross_ref_integrity": {"type": "number", "minimum": 0, "maximum": 5}
      }
    },
    "overall": {"type": "number", "minimum": 0, "maximum": 5},
    "verdict": {"type": "string", "enum": ["PASS", "FIX"]},
    "manual_review_required": {"type": "boolean"},
    "reason": {
      "type": "string",
      "description": "manual_review_required が true の場合の理由"
    },
    "git_sha": {
      "type": "string",
      "description": "評価時の HEAD SHA"
    }
  }
}
